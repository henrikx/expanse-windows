<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Expanse</AssemblyName>
    <RootNamespace>Expanse</RootNamespace>
    <ApplicationIcon>Expanse.ico</ApplicationIcon>
    <Version>0.2.12</Version>
  </PropertyGroup>
  <!-- A release runs on a PC without .NET, from the one file. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <!-- Every Release build (dotnet publish's default) is a release, which updates itself. -->
  <ItemGroup Condition="'$(Configuration)' == 'Release' Or '$(ExpanseRelease)' == 'true'">
    <AssemblyMetadata Include="ExpanseRelease" Value="true" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Native\*.cs" Link="Native\%(Filename)%(Extension)" />
    <ProjectReference Include="..\Layout\Layout.csproj" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
  </ItemGroup>
  <!-- The zip the updater looks for on a GitHub release, beside Expanse.exe. Not for scripts/release.sh, which zips the folder itself. -->
  <Target Name="ZipForRelease" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release' And '$(PublishSingleFile)' == 'true' And '$(ExpanseRelease)' != 'true'">
    <PropertyGroup>
      <ReleaseZipFolder>$(IntermediateOutputPath)release-zip/</ReleaseZipFolder>
    </PropertyGroup>
    <RemoveDir Directories="$(ReleaseZipFolder)" />
    <Copy SourceFiles="$(PublishDir)Expanse.exe" DestinationFolder="$(ReleaseZipFolder)" />
    <ZipDirectory SourceDirectory="$(ReleaseZipFolder)" DestinationFile="$(PublishDir)Expanse-$(Version)-windows-$(RuntimeIdentifier.Replace('win-', '')).zip" Overwrite="true" />
  </Target>
</Project>
